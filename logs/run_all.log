        view_name        |                                        view_definition                                         
-------------------------+------------------------------------------------------------------------------------------------
 cagg_energy_15m_region  |  SELECT time_bucket('00:15:00'::interval, r.event_time) AS bucket,                            +
                         |     m.region,                                                                                 +
                         |     sum(r.energy_kwh) AS sum_energy_kwh,                                                      +
                         |     sum(r.power_kw) AS sum_power_kw,                                                          +
                         |     count(*) AS reading_count                                                                 +
                         |    FROM (energy_readings r                                                                    +
                         |      JOIN meters m ON ((r.meter_id = m.meter_id)))                                            +
                         |   GROUP BY (time_bucket('00:15:00'::interval, r.event_time)), m.region;
 cagg_energy_day_meter   |  SELECT time_bucket('1 day'::interval, event_time, 'Africa/Kigali'::text) AS bucket,          +
                         |     meter_id,                                                                                 +
                         |     sum(energy_kwh) AS sum_energy_kwh,                                                        +
                         |     sum(power_kw) AS sum_power_kw,                                                            +
                         |     count(*) AS reading_count                                                                 +
                         |    FROM energy_readings                                                                       +
                         |   GROUP BY (time_bucket('1 day'::interval, event_time, 'Africa/Kigali'::text)), meter_id;
 cagg_energy_hour_region |  SELECT time_bucket('01:00:00'::interval, r.event_time, 'Africa/Kigali'::text) AS bucket,     +
                         |     m.region,                                                                                 +
                         |     sum(r.energy_kwh) AS sum_energy_kwh,                                                      +
                         |     sum(r.power_kw) AS sum_power_kw,                                                          +
                         |     count(*) AS reading_count                                                                 +
                         |    FROM (energy_readings r                                                                    +
                         |      JOIN meters m ON ((r.meter_id = m.meter_id)))                                            +
                         |   GROUP BY (time_bucket('01:00:00'::interval, r.event_time, 'Africa/Kigali'::text)), m.region;
